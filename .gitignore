# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Blender
*.blend
*.blend1
*.blend2
*.blend@

# Build e rilascio
dist/
*.zip
*.rar

# Output di test e probe (rigenerabili)
.opencode/tests/*_out*.txt
.opencode/probe/*.png
*.log

# Esperimenti locali (non pubblicati)
_esperimenti/

# Note locali non pubblicate
AGENTS.md
opencode.json

# Cartella locale OpenCode (agenti, script, skills): ignorata per default, resta intatta su
# disco. Le suite headless (.opencode/tests/*.py) sono eccezione deliberata: la CI
# (.github/workflows/ci.yml) le esegue direttamente con --python e deve trovarle nel repo.
/.opencode/*
!/.opencode/tests/

# Derivati locali del nucleo deterministico (verdetto, telemetria, lock)
/.opencode/metrics.jsonl
/.opencode/verdict.txt
/.opencode/gate.lock
/.opencode/scratch/
/.opencode/INDEX.md

# File temporaneo estraneo (esportazione sessione, mai da committare)
/verifica-delle-istruzioni-in-agents-md.json
